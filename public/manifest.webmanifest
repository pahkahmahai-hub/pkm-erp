{
  "name": "PKM ERP — ปากาม้า",
  "short_name": "PKM ERP",
  "start_url": "/work",
  "display": "standalone",
  "background_color": "#fff6ea",
  "theme_color": "#452a79",
  "icons": [
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "บันทึกค่าใช้จ่ายด่วน",
      "url": "/expenses/quick",
      "icons": [
        {
          "src": "/icon.png",
          "sizes": "512x512"
        }
      ]
    },
    {
      "name": "เตรียมจ่าย",
      "url": "/expenses/payables",
      "icons": [
        {
          "src": "/icon.png",
          "sizes": "512x512"
        }
      ]
    }
  ]
}